  HAL_NVIC_SetPriority(DMA1_Channel1_IRQn, 0, 0);
  // HAL_NVIC_EnableIRQ(DMA1_Channel1_IRQn);   /* 轮询 adc_raw 不需要 DMA 中断；开着会以最高优先级疯狂触发、饿死 SysTick 导致 HAL_Delay 卡死/跑飞 */

